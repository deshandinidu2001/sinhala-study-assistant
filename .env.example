# Copy to .env before running Docker Compose. Never commit .env.
POSTGRES_USER=study
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=sinhala_study
POSTGRES_PORT=55432
# Local Python commands use this URL. Compose supplies its internal database URL.
DATABASE_URL=postgresql+psycopg://study:change-this-local-password@127.0.0.1:55432/sinhala_study
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
STORAGE_PATH=./storage
APP_ENV=development
LOG_LEVEL=INFO
# Optional: server-side Gemini for Singlish interpretation and cited explanations.
# Leave blank for fully local answering. Never use a NEXT_PUBLIC_ API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Standard Grade 11 MCQs use a separate model; requires a valid Gemini key.
GEMINI_QUIZ_MODEL=gemini-3.1-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=15
# Reserved model settings. Current answers use local lexical source extraction.
# These fields do not activate an external AI model or Whisper service.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.45
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
OCR_LANGUAGE=sin
MAX_UPLOAD_MB=25
